<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Notepad</AssemblyName>
    <Version>0.0.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Emgu.CV" Version="4.12.0.5764" />
    <PackageReference Include="Emgu.CV.Bitmap" Version="4.12.0.5764" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Form\Form_Insect.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form\Form_Herb.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form\Form_Wood.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form\Form_Mining.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Form\Form_Hoeing.cs" />
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>